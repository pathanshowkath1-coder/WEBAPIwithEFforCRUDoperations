<html>
<body>
    <h1>JQuery AJAX Web API- Search</h1>
    <form>
        Search: <input type="text" id="txt1" placeholder="Search" />
        <input type="submit" id="button1" value="SEARCH" />
        <table id="table1" border="1"></table>
    </form>
    <script src="~/Scripts/jquery-3.7.0.js"></script>"
    <script>
        $("#button1").click(fun1);
        function fun1
        {
            event.preventDefault();
            $.ajax({ URL: "/api/Employee?str=" + $("#txt1").val(), type: "GET", success:fun2, error: fun3 });
        }
        function fun2(response)
        {
            $("#table1").html("<tr><th>Emp ID</th><th>Emp Name</th><th>Salary</th></tr>");
            for (var i = 0; i < response.length; i++)
            {
                $("#table1").append("<tr><td>" + response[i].EmpId + "</td><td>" + response[i].EmpName + "</td><td>" + response[i].Salary + "</td></tr>");
            }
        }
        function fun3(xhr)
        {
            alert(xhr.responseText);
        }
    </script>
</body>
</html>